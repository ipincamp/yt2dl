{
  "name": "yt2dl",
  "version": "2.0.0",
  "description": "YouTube Downloader using NodeJS",
  "main": "dist/index.js",
  "type": "module",
  "repository": "https://github.com/ipincamp/yt2dl.git",
  "author": "ipincamp <support@nur-arifin.my.id>",
  "license": "GPL-3.0",
  "private": true,
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.x",
    "yarn": ">=1.22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:pm2": "pm2 start ecosystem.dev.config.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop all",
    "restart:pm2": "pm2 restart all",
    "logs:pm2": "pm2 logs",
    "monit:pm2": "pm2 monit",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "prebuild": "yarn clean && yarn lint && yarn format:check && yarn type-check",
    "prepare": "husky",
    "validate": "yarn lint && yarn format:check && yarn type-check"
  },
  "dependencies": {
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
